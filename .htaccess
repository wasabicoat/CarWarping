# Apache only (ignored by `php -S`). Every block is optional and guarded.

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # app.css / app.js are requested with ?v=<mtime>, so they can be cached for a long time
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  # Original photos/videos rarely change
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
</IfModule>

Options -Indexes

# Don't serve internals directly
<FilesMatch "^(lib|warm)\.php$|\.md$">
  Require all denied
</FilesMatch>
